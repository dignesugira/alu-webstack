#!/usr/bin/env bash
# Displays the DNS record type and destination of a domain's subdomains
show_record() {
    dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -1 | awk -v s="$2" '{print "The subdomain " s " is a " $4 " record and points to " $5}'
}

if [ -z "$2" ]; then
    for subdomain in www lb-01 web-01 web-02; do
        show_record "$1" "$subdomain"
    done
else
    show_record "$1" "$2"
fi
